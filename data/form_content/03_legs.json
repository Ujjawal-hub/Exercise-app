      "exercise": "Romanian Deadlift",
      "wger_id": 507,
      "reviewed": false,
      "setup": "Barbell or dumbbells in front of the thighs, feet hip-width, soft knees.",
      "source_name": "NASM; Barbell Logic",
      "source_url": "https://blog.nasm.org/romanian-deadlift-basics",
      "demo_url": "https://blog.nasm.org/romanian-deadlift-basics",
      "steps": [
        "Stand tall, shoulders back, bar at hips.",
        "Push hips back with only a small knee bend, bar sliding down your thighs.",
        "Lower until you feel a hamstring stretch, back flat.",
        "Drive hips forward to stand, squeezing glutes."
      ],
      "mistakes": [
        {
          "mistake": "Rounding the back",
          "fix": "Chest up, stop where the spine stays flat."
        },
        {
          "mistake": "Squatting it (too much knee bend)",
          "fix": "Hinge at the hips, knees nearly fixed."
        },
        {
          "mistake": "Bar drifting away from the legs",
          "fix": "Keep the bar in contact with your legs."
        },
        {
          "mistake": "Hyperextending at the top",
          "fix": "Stand tall, do not lean back."
        }
      ]
    },
